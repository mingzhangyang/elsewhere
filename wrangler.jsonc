// Cloudflare Workers deployment: static assets only, no Worker code yet (see ROADMAP.md, phase 0).
{
  "name": "elsewhere",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
  },
  "routes": [{ "pattern": "elsewhere.orangely.xyz", "custom_domain": true }],
  // One public origin: shared links are built from the page's own origin, so a second one would split them.
  "workers_dev": false,
  "preview_urls": false,
}
