{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // The Sky Engine examples import the package by name, as a host would.
    "paths": { "@orangely/sky-engine": ["./packages/sky-engine/src/index.ts"] }
  },
  "include": [
    "src",
    "packages/sky-engine/src",
    "packages/sky-engine/examples",
    "packages/sky-engine/test",
    "tests",
    "*.config.ts"
  ]
}
