# Cache rules read by Cloudflare static assets (see docs/RELEASE.md). Cloudflare does not serve this file.
# Other files keep Cloudflare's default, which revalidates on every request.

# Every file under /assets/ carries a content hash (checked by scripts/check-build.mjs).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
